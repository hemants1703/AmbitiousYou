{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- apps/frontend packages/shared .github/workflows/ci-frontend.yml",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "ambitiousyou.pro" }],
      "destination": "https://www.ambitiousyou.pro/:path*",
      "permanent": true
    }
  ]
}
