# Backend environment — copy to .env.development (local) and set real values.
# In production/dev DEPLOYMENTS these are injected by the orchestrator — NEVER
# committed. .env.production is gitignored — keep it that way.
#   VPS   : /opt/ambitiousyou/<env>/backend.env (+ CI migrate step)
#   Vercel: project Settings → Environment Variables (Production / Preview)

# API port (defaults to 3001 if unset)
PORT=3001

# Frontend origin used to build links inside transactional emails
# (verify, reset, dashboard). Per environment:
#   local : http://localhost:3000
#   dev   : https://dev.ambitiousyou.pro
#   prod  : https://www.ambitiousyou.pro
APP_BASE_URL=http://localhost:3000

# Postgres connection string (Drizzle runtime + drizzle-kit CLI).
#   local : postgresql://postgres:postgres@localhost:5432/ambitiousyou_dev?schema=public
#   cloud : copy the **Session pooler** URI from Supabase (IPv4, port 5432).
#           Dashboard → Project Settings → Database → Connection string →
#           "Session pooler" → URI. Do NOT hand-edit host/region — use the exact
#           value (aws-0 vs aws-1 region must match your project).
#           Username is postgres.<project-ref>. Append ssl if the dashboard omits it:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#   Vercel / serverless: use Session pooler (5432), NOT the direct db.*.supabase.co
#           host (IPv6) and NOT Transaction pooler (6543) — Nest uses DB transactions.
#           URL-encode special characters in the password (@, #, /, etc.).
#   If logs say "tenant/user postgres.<ref> not found", the URL is wrong for that
#           project (stale ref, wrong pooler region, or dev/prod secret swapped).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ambitiousyou_dev?schema=public

# Azure Communication Services — transactional email. Optional: if unset the
# backend logs a warning and disables outbound email.
AZURE_CONNECTION_STRING="endpoint=https://<region>.communication.azure.com/;accesskey=<key>"

# Web Push (VAPID). Generate once:
#   npx web-push generate-vapid-keys
# Public key is also exposed to the frontend (NEXT_PUBLIC_VAPID_PUBLIC_KEY).
# If unset, inbox reminders still work; on-device push is skipped.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@ambitiousyou.pro

# Shared secret for GitHub Actions reminders-cron → POST /internal/reminders/run
# Authorization: Bearer <CRON_SECRET>
# Also set the same value as a GitHub Actions secret (environment: production-backend)
# alongside REMINDERS_API_URL (your Render API base URL).
CRON_SECRET=

# Comma-separated founder emails promoted to plan=pro on login only (optional).
# Signup always inserts free. Leave empty and use SQL instead if you prefer.
FOUNDER_PLAN_EMAILS=

# Stealth founder-only features (optional — routes return 503 when unset)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3001/calendar/callback
