{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile --filter backend...",
  "buildCommand": "cd ../.. && pnpm --filter backend build",
  "ignoreCommand": "git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" \"${VERCEL_GIT_COMMIT_SHA:-HEAD}\" -- . ../../pnpm-lock.yaml 2>/dev/null || exit 1",
  "git": {
    "deploymentEnabled": false
  }
}
