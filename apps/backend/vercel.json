{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile --filter backend...",
  "buildCommand": "cd ../.. && pnpm --filter backend build",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- apps/backend packages/shared .github/workflows/deploy-backend.yml",
  "env": {
    "NODE_OPTIONS": "--require ./dist/register-paths.js"
  }
}
